set working-directory := '../..'
set positional-arguments

# List evaluation commands.
default:
    @just --list eval

# Install the test-object dependencies without downloading an Electron app.
setup:
    pnpm install --frozen-lockfile --ignore-scripts --filter @auv-evals/test-objects

# Build AUV, the evaluation runners, and the test objects.
build:
    cargo build -p auv-cli -p auv-base-evals --bins
    pnpm --filter @auv-evals/test-objects build

# Check Rust and TypeScript without launching GUI applications.
check:
    cargo fmt -p auv-base-evals --check
    cargo check -p auv-base-evals --all-targets
    pnpm --filter @auv-evals/test-objects typecheck
    pnpm exec eslint evals/auv-base/platforms/desktop-universal/test-objects

# Run macOS keyboard cases through the CLI.
keyboard *args: build
    target/debug/keyboard-eval "$@"

# Run macOS held-key cases through the persistent Rust sender.
hold *args: build
    target/debug/keyboard-eval --sender target/debug/keyboard-receiver-sender "$@"

# Run macOS focus preparation and restoration cases.
focus *args: build
    target/debug/focus-eval "$@"

# Run the opt-in native AppKit keyboard test.
appkit:
    cargo test -p auv-base-evals --test appkit-keyboard -- --include-ignored --nocapture

# Compare assertions against existing local receipts, without launching apps.
replay receipts:
    AUV_EVAL_RECEIPTS="$1" cargo test -p auv-base-evals --lib migrated_assertions_match_recorded_receipts -- --include-ignored
