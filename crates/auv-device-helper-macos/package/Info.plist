<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CFBundleDevelopmentRegion</key><string>en</string>
  <key>CFBundleExecutable</key><string>auv-device-helper-macos</string>
  <key>CFBundleIdentifier</key><string>ai.moeru.auv.helper</string>
  <key>CFBundleDisplayName</key><string>AUV Helper</string>
  <key>CFBundleIconFile</key><string>AUV Helper</string>
  <key>CFBundleIconName</key><string>AUV Helper</string>
  <key>CFBundleInfoDictionaryVersion</key><string>6.0</string>
  <key>CFBundleName</key><string>AUV Helper</string>
  <key>CFBundlePackageType</key><string>APPL</string>
  <!-- package.sh replaces this placeholder from the Cargo package version. -->
  <key>CFBundleShortVersionString</key><string>0.0.0</string>
  <key>CFBundleVersion</key><string>1</string>
  <key>LSUIElement</key><true/>
  <key>LSMinimumSystemVersion</key><string>13.0</string>
  <!-- Must equal SUPPORTED_PROTOCOLS in src/lib.rs; a unit test enforces it. -->
  <key>AUVHelperProtocolMin</key><integer>1</integer>
  <key>AUVHelperProtocolMax</key><integer>1</integer>
  <!-- Must be a string: code requirements compare only string values. Raise
       together with MIN_SECURITY_EPOCH in src/lib.rs to revoke older helpers. -->
  <key>AUVHelperSecurityEpoch</key><string>1</string>
</dict>
</plist>
