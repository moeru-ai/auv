#!/usr/bin/env bash

set -euo pipefail

baseline="${1:?usage: scripts/tests/verify-elf-glibc-baseline <version> <elf>...}"
shift
test "$#" -gt 0 || { echo 'at least one ELF path is required' >&2; exit 2; }

max_glibc="$({ for elf in "$@"; do readelf --version-info "$elf"; done; } \
  | grep -o 'GLIBC_[0-9][0-9.]*' \
  | sed 's/^GLIBC_//' \
  | sort -Vu \
  | tail -n 1)"
if test "$(printf '%s\n' "$max_glibc" "$baseline" | sort -V | tail -n 1)" != "$baseline"; then
  echo "ELF requires GLIBC_$max_glibc, newer than the declared GLIBC_$baseline baseline" >&2
  exit 1
fi

printf 'maximum required glibc symbol: GLIBC_%s\n' "$max_glibc"
