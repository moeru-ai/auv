#!/usr/bin/env bash

set -euo pipefail

archive="${1:?usage: scripts/tests/verify-linux-release-archive <archive> <target> <version>}"
target="${2:?missing target}"
version="${3:?missing version}"

root="$(mktemp -d)"
trap 'rm -rf "$root"' EXIT
tar -xzf "$archive" -C "$root"

test -x "$root/auv"
test -s "$root/share/auv/tessdata/eng.traineddata"
test -d "$root/lib/auv"
test -n "$(find "$root/lib/auv" -type f -print -quit)"
test -s "$root/licenses/auv/LICENSE"
test -n "$(find "$root/licenses/system" -type f -name '*.copyright' -print -quit)"

python3 - "$root" "$target" "$version" <<'PY'
import hashlib
import json
import pathlib
import sys

root = pathlib.Path(sys.argv[1])
manifest = json.loads((root / 'manifest.json').read_text())
assert manifest['schemaVersion'] == 1
assert manifest['target'] == sys.argv[2]
assert manifest['version'] == sys.argv[3]
assert manifest['glibcBaseline'] == '2.36'
assert manifest['layout']['executable'] == 'auv'
assert manifest['layout']['libraryDirectory'] == 'lib/auv'
assert manifest['layout']['tessdataDirectory'] == 'share/auv/tessdata'

actual_libraries = {
    path.relative_to(root).as_posix()
    for path in (root / 'lib' / 'auv').iterdir()
    if path.is_file()
}  # PipeWire modules and SPA plugins live in subdirectories and are listed in `files`.
recorded_libraries = {entry['path'] for entry in manifest['libraries']}
assert recorded_libraries == actual_libraries, recorded_libraries ^ actual_libraries
for library in manifest['libraries']:
    assert library['package']
    assert (root / library['license']).is_file(), library

assert manifest['models'] == [{
    'language': 'eng',
    'path': 'share/auv/tessdata/eng.traineddata',
    'package': manifest['models'][0]['package'],
    'license': manifest['models'][0]['license'],
}]
assert manifest['models'][0]['package']
assert (root / manifest['models'][0]['license']).is_file()

recorded = {entry['path']: entry for entry in manifest['files']}
actual = {
    path.relative_to(root).as_posix(): path
    for path in root.rglob('*')
    if path.is_file() and path.name != 'manifest.json'
}
assert recorded.keys() == actual.keys(), (recorded.keys() ^ actual.keys())
for relative, path in actual.items():
    digest = hashlib.sha256(path.read_bytes()).hexdigest()
    assert recorded[relative]['sha256'] == digest, relative
    assert recorded[relative]['size'] == path.stat().st_size, relative
PY

# Keep the dynamic-loader token literal; the shell must not expand it.
# shellcheck disable=SC2016
test "$(patchelf --print-rpath "$root/auv")" = '$ORIGIN/lib/auv'
while IFS= read -r -d '' library; do
  # shellcheck disable=SC2016
  test "$(patchelf --print-rpath "$library")" = '$ORIGIN'
done < <(find "$root/lib/auv" -maxdepth 1 -type f -print0)
while IFS= read -r -d '' module; do
  # shellcheck disable=SC2016
  test "$(patchelf --print-rpath "$module")" = '$ORIGIN:$ORIGIN/..'
done < <(find "$root/lib/auv/pipewire-0.3" -type f -print0)
while IFS= read -r -d '' plugin; do
  # shellcheck disable=SC2016
  test "$(patchelf --print-rpath "$plugin")" = '$ORIGIN/../..'
done < <(find "$root/lib/auv/spa-0.2" -mindepth 2 -type f -print0)
# The bundled client configuration must only name modules and plugins the
# bundle ships; libpipewire cannot start a context otherwise.
test -s "$root/share/auv/pipewire/client.conf"
active_client_conf="$(sed 's/#.*//' "$root/share/auv/pipewire/client.conf")"
while IFS= read -r module; do
  test -f "$root/lib/auv/pipewire-0.3/$module.so" || { echo "client.conf names missing module $module" >&2; exit 1; }
done < <(grep -oE 'libpipewire-module-[a-z0-9-]+' <<< "$active_client_conf" | sort -u)
while IFS= read -r plugin; do
  test -f "$root/lib/auv/spa-0.2/$plugin.so" || { echo "client.conf names missing SPA plugin $plugin" >&2; exit 1; }
done < <(grep -oE '[a-z0-9-]+/libspa-[a-z0-9-]+' <<< "$active_client_conf" | sort -u)
test -f "$root/lib/auv/pipewire-0.3/libpipewire-module-protocol-native.so"
if find "$root/lib/auv" -maxdepth 1 -name 'libpipewire-module-*' | grep -q .; then
  echo 'PipeWire modules must only live in lib/auv/pipewire-0.3' >&2
  exit 1
fi
mapfile -d '' bundled_libraries < <(find "$root/lib/auv" -type f -print0)
"$(dirname "$0")/verify-elf-glibc-baseline" 2.36 "$root/auv" "${bundled_libraries[@]}"
verify_dependency_closure() {
  local elf="$1"
  local resolved name
  while IFS= read -r line; do
    case "$line" in
      *'=> not found'*) echo "$elf has an unresolved dependency: $line" >&2; return 1 ;;
      *'=>'*) resolved="$(printf '%s\n' "$line" | awk '{ print $3 }')" ;;
      /*) resolved="$(printf '%s\n' "$line" | awk '{ print $1 }')" ;;
      *) continue ;;
    esac
    case "$resolved" in
      "$root/lib/auv/"*) continue ;;
    esac
    name="$(basename "$resolved")"
    case "$name" in
      ld-linux*.so*|libanl.so*|libc.so*|libdl.so*|libm.so*|libnss_*.so*|libpthread.so*|libresolv.so*|librt.so*|libthread_db.so*|libutil.so*) ;;
      *) echo "$elf resolves non-runtime dependency $name outside the private bundle: $resolved" >&2; return 1 ;;
    esac
  done < <(LD_LIBRARY_PATH="$root/lib/auv" ldd "$elf")
}

verify_dependency_closure "$root/auv"
while IFS= read -r -d '' library; do
  verify_dependency_closure "$library"
done < <(find "$root/lib/auv" -type f -print0)
ldd "$root/auv" | grep -E "lib(tesseract|lept).*=> $root/lib/auv/" >/dev/null
"$root/auv" --help >/dev/null
