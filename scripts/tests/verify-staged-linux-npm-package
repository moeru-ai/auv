#!/usr/bin/env bash

set -euo pipefail

package_root="${1:?usage: scripts/tests/verify-staged-linux-npm-package <package-directory>}"

test -x "$package_root/bin/auv"
test -s "$package_root/bin/manifest.json"
test -s "$package_root/bin/share/auv/tessdata/eng.traineddata"
test -n "$(find "$package_root/bin/lib/auv" -type f -print -quit)"
test -n "$(find "$package_root/bin/licenses/system" -type f -name '*.copyright' -print -quit)"

python3 - "$package_root" <<'PY'
import json
import pathlib
import sys

root = pathlib.Path(sys.argv[1])
package = json.loads((root / 'package.json').read_text())
assert 'bin' in package['files']
assert 'bin/auv' not in package['files']

release = json.loads((root / 'bin/manifest.json').read_text())
assert release['layout']['executable'] == 'auv'
assert release['layout']['libraryDirectory'] == 'lib/auv'
assert release['layout']['tessdataDirectory'] == 'share/auv/tessdata'
PY

pack_root="$(mktemp -d)"
trap 'rm -rf "$pack_root"' EXIT
tarball="$(cd "$package_root" && npm pack --pack-destination "$pack_root" --silent)"
tar -tzf "$pack_root/$tarball" | grep -Fq 'package/bin/auv'
tar -tzf "$pack_root/$tarball" | grep -Fq 'package/bin/lib/auv/'
tar -tzf "$pack_root/$tarball" | grep -Fq 'package/bin/share/auv/tessdata/eng.traineddata'
tar -tzf "$pack_root/$tarball" | grep -Fq 'package/bin/licenses/system/'
