#!/usr/bin/env bash

set -euo pipefail

usage() {
  cat <<'EOF'
Usage: scripts/package-linux-release \
  --binary <path> \
  --archive <path> \
  --target <rust-target> \
  --version <version> \
  --project-license <path>
EOF
}

binary=''
archive=''
target=''
version=''
project_license=''
while (($#)); do
  case "$1" in
    --binary) binary="$2"; shift 2 ;;
    --archive) archive="$2"; shift 2 ;;
    --target) target="$2"; shift 2 ;;
    --version) version="$2"; shift 2 ;;
    --project-license) project_license="$2"; shift 2 ;;
    --help|-h) usage; exit 0 ;;
    *) echo "unknown argument: $1" >&2; usage >&2; exit 2 ;;
  esac
done

for command in dpkg-query jq ldd patchelf sha256sum tar; do
  command -v "$command" >/dev/null || { echo "required command not found: $command" >&2; exit 1; }
done
for required in "$binary" "$project_license"; do
  test -f "$required" || { echo "required file not found: $required" >&2; exit 1; }
done
test -n "$archive" && test -n "$target" && test -n "$version" || { usage >&2; exit 2; }

work_root="$(mktemp -d)"
trap 'rm -rf "$work_root"' EXIT
# The archive root is the install directory, so it gets 0755 rather than
# `mktemp -d`'s 0700.
package_root="$work_root/package"
mkdir -m 0755 "$package_root"
mkdir -p "$package_root/lib/auv" "$package_root/share/auv/tessdata" "$package_root/licenses/auv" "$package_root/licenses/system"
install -m 0755 "$binary" "$package_root/auv"
install -m 0644 "$project_license" "$package_root/licenses/auv/LICENSE"

is_runtime_provided_library() {
  case "$1" in
    ld-linux*.so*|libanl.so*|libc.so*|libdl.so*|libm.so*|libnss_*.so*|libpthread.so*|libresolv.so*|librt.so*|libthread_db.so*|libutil.so*) return 0 ;;
    *) return 1 ;;
  esac
}

package_for_file() {
  local installed_file="$1"
  local ownership
  ownership="$(dpkg-query -S "$installed_file" 2>/dev/null | head -n 1 || true)"
  test -n "$ownership" || return 1
  printf '%s\n' "${ownership%%:*}"
}

copy_package_license() {
  local package="$1"
  local copyright
  copyright="/usr/share/doc/$package/copyright"
  test -f "$copyright" || { echo "copyright file not found for package $package" >&2; exit 1; }
  install -m 0644 "$copyright" "$package_root/licenses/system/$package.copyright"
}

# Lists the shared-library closure of one ELF file as this host's dynamic
# loader resolves it, one path per line.
# NOTICE: this uses glibc's `ldd`, not `lddtree`. Debian 12 ships `lddtree` in
# `pax-utils` as a Python script, which would bring Python back into the release
# build. `ldd` runs the loader on the file, so only use it on trusted ELF files,
# which our own build and Debian's packages are.
library_closure() {
  local output line
  output="$(ldd "$1")" || { echo "ldd failed on $1" >&2; return 1; }
  while read -r line; do
    case "$line" in
      *'=> not found'*) echo "$1 has an unresolved dependency: $line" >&2; return 1 ;;
      *' => /'*) line="${line#* => }"; printf '%s\n' "${line% (0x*}" ;;
      # The dynamic loader is listed by path alone.
      /*) printf '%s\n' "${line% (0x*}" ;;
    esac
  done <<< "$output"
}

library_metadata="$work_root/library-packages.tsv"
: > "$library_metadata"
# Copies the shared-library closure of one ELF file into lib/auv.
bundle_dependencies() {
  local elf="$1"
  local closure dependency resolved name destination package
  closure="$(library_closure "$elf")"
  while IFS= read -r dependency; do
    test -f "$dependency" || continue
    resolved="$(readlink -f "$dependency")"
    name="$(basename "$dependency")"
    test "$resolved" != "$(readlink -f "$elf")" || continue
    is_runtime_provided_library "$name" && continue
    # A PipeWire module that links another module finds it beside itself.
    case "$resolved" in
      */pipewire-0.3/libpipewire-module-*.so)
        test -f "$package_root/lib/auv/pipewire-0.3/$name" || { echo "$elf needs PipeWire module $name, which client.conf does not load" >&2; exit 1; }
        continue
        ;;
    esac

    destination="$package_root/lib/auv/$name"
    if test -e "$destination"; then
      cmp -s "$resolved" "$destination" || { echo "dependency basename collision for $name" >&2; exit 1; }
      continue
    fi
    install -m 0644 "$resolved" "$destination"
    package="$(package_for_file "$resolved" || package_for_file "$dependency")"
    copy_package_license "$package"
    printf '%s\t%s\t%s\n' "lib/auv/$name" "$package" "licenses/system/$package.copyright" >> "$library_metadata"
  done <<< "$closure"
}
bundle_dependencies "$binary"

# NOTICE(linux-bundled-pipewire): the bundled libpipewire loads client modules,
# SPA plugins and client.conf at runtime. Host files built for a newer
# PipeWire need symbols it lacks (Debian 13 PipeWire 1.4 and Ubuntu 26.04
# PipeWire 1.6 fail with `undefined symbol: pw_log_topic_register`), so ship
# the matching client files and let `auv_driver_linux::bundle` point
# libpipewire at them. The bundle still talks to the host daemon through its
# socket protocol, as Flatpak runtimes do.
pipewire_library="$(library_closure "$binary" | awk '/\/libpipewire-0\.3\.so\.0$/ { print; exit }')"
test -n "$pipewire_library" || { echo 'auv does not link libpipewire-0.3.so.0' >&2; exit 1; }
pipewire_lib_dir="$(dirname "$(readlink -f "$pipewire_library")")"
client_conf=/usr/share/pipewire/client.conf
test -f "$client_conf" || { echo "PipeWire client configuration not found: $client_conf" >&2; exit 1; }
mkdir -p "$package_root/share/auv/pipewire" "$package_root/lib/auv/pipewire-0.3" "$package_root/lib/auv/spa-0.2"
install -m 0644 "$client_conf" "$package_root/share/auv/pipewire/client.conf"
copy_package_license "$(package_for_file "$client_conf")"
active_client_conf="$(sed 's/#.*//' "$client_conf")"
mapfile -t pipewire_modules < <(grep -oE 'libpipewire-module-[a-z0-9-]+' <<< "$active_client_conf" | sort -u)
mapfile -t spa_plugins < <(grep -oE '[a-z0-9-]+/libspa-[a-z0-9-]+' <<< "$active_client_conf" | sort -u)
test "${#pipewire_modules[@]}" -gt 0 || { echo "no PipeWire modules found in $client_conf" >&2; exit 1; }
for module in "${pipewire_modules[@]}"; do
  source_file="$pipewire_lib_dir/pipewire-0.3/$module.so"
  test -f "$source_file" || { echo "PipeWire module not found: $source_file" >&2; exit 1; }
  install -m 0644 "$source_file" "$package_root/lib/auv/pipewire-0.3/$module.so"
  copy_package_license "$(package_for_file "$source_file")"
done
for module in "${pipewire_modules[@]}"; do
  bundle_dependencies "$pipewire_lib_dir/pipewire-0.3/$module.so"
done
for plugin in "${spa_plugins[@]}"; do
  source_file="$pipewire_lib_dir/spa-0.2/$plugin.so"
  test -f "$source_file" || { echo "SPA plugin not found: $source_file" >&2; exit 1; }
  install -D -m 0644 "$source_file" "$package_root/lib/auv/spa-0.2/$plugin.so"
  copy_package_license "$(package_for_file "$source_file")"
  bundle_dependencies "$source_file"
done

eng_model="$(dpkg-query -L tesseract-ocr-eng | awk '/\/eng\.traineddata$/ { print; exit }')"
test -f "$eng_model" || { echo 'tesseract-ocr-eng did not provide eng.traineddata' >&2; exit 1; }
install -m 0644 "$eng_model" "$package_root/share/auv/tessdata/eng.traineddata"
model_package="$(package_for_file "$eng_model")"
copy_package_license "$model_package"

# Keep the dynamic-loader token literal; the shell must not expand it.
# shellcheck disable=SC2016
patchelf --set-rpath '$ORIGIN/lib/auv' "$package_root/auv"
# Shared libraries sit directly in lib/auv; PipeWire modules one level and SPA
# plugins two levels below it. Modules also find the modules they link.
# shellcheck disable=SC2016
find "$package_root/lib/auv" -maxdepth 1 -type f -exec patchelf --set-rpath '$ORIGIN' {} +
# shellcheck disable=SC2016
find "$package_root/lib/auv/pipewire-0.3" -type f -exec patchelf --set-rpath '$ORIGIN:$ORIGIN/..' {} +
# shellcheck disable=SC2016
find "$package_root/lib/auv/spa-0.2" -mindepth 2 -type f -exec patchelf --set-rpath '$ORIGIN/../..' {} +

file_metadata="$work_root/files.tsv"
(
  cd "$package_root"
  find . -type f -printf '%P\n' | LC_ALL=C sort | while IFS= read -r path; do
    printf '%s\t%s\t%s\n' "$path" "$(sha256sum "$path" | cut -d ' ' -f 1)" "$(stat -c %s "$path")"
  done
) > "$file_metadata"
jq -n \
  --arg version "$version" \
  --arg target "$target" \
  --arg model_package "$model_package" \
  --rawfile libraries "$library_metadata" \
  --rawfile files "$file_metadata" '
  def rows($tsv): $tsv | split("\n") | map(select(length > 0) | split("\t"));
  {
    schemaVersion: 1,
    name: "auv",
    version: $version,
    target: $target,
    glibcBaseline: "2.36",
    layout: {
      executable: "auv",
      libraryDirectory: "lib/auv",
      tessdataDirectory: "share/auv/tessdata"
    },
    libraries: (rows($libraries) | map({path: .[0], package: .[1], license: .[2]}) | sort_by(.path)),
    models: [{
      language: "eng",
      path: "share/auv/tessdata/eng.traineddata",
      package: $model_package,
      license: "licenses/system/\($model_package).copyright"
    }],
    files: (rows($files) | map({path: .[0], sha256: .[1], size: (.[2] | tonumber)}))
  }' > "$package_root/manifest.json"

# TODO(linux-minimal-artifact): keep the default archive self-contained; add a
# separate auv-minimal artifact only after its distro dependency contract and
# package-manager documentation are owner-approved.
mkdir -p "$(dirname "$archive")"
tar --sort=name --mtime='@0' --owner=0 --group=0 --numeric-owner -czf "$archive" -C "$package_root" .
