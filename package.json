{
  "name": "@auv-js/root",
  "type": "module",
  "version": "0.0.29",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "build": "pnpm --filter @auv-js/api-client --filter \"./js/packages/*\" --if-present build",
    "docs:toc": "doctoc --github --title \"## Table of Contents\" --maxlevel=2 README.md js/packages/sdk/README.md proto/sdk/js/README.md",
    "docs:update": "pnpm docs:toc",
    "generate:proto": "cd proto && buf generate --template buf.gen.yaml",
    "lint:fix": "moeru-lint --fix . && pnpm --filter @auv-js/repl-playground lint:fix",
    "lint": "moeru-lint . && pnpm --filter @auv-js/repl-playground lint",
    "test:run": "pnpm --filter @auv-js/api-client --filter \"./js/packages/*\" --filter @auv-js/repl-playground --if-present test:run",
    "typecheck": "pnpm --filter @auv-js/api-client --filter \"./js/packages/*\" --filter @auv-js/repl-playground --if-present typecheck",
    "up": "taze -w -r -I && pnpm prune && pnpm dedupe",
    "nolyfill": "pnpm dlx nolyfill"
  },
  "devDependencies": {
    "@alint-js/cli": "catalog:",
    "@auv-js/alint-config": "workspace:*",
    "@decimalturn/toml-patch": "catalog:",
    "@moeru/eslint-config": "catalog:",
    "@pnpm/find-workspace-dir": "catalog:",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:vitest",
    "bumpp": "catalog:",
    "doctoc": "catalog:",
    "eslint": "catalog:",
    "eslint-plugin-oxlint": "catalog:",
    "eslint-plugin-slop": "catalog:",
    "nano-staged": "catalog:",
    "oxlint": "catalog:",
    "playwright": "catalog:",
    "publint": "catalog:",
    "simple-git-hooks": "catalog:",
    "taze": "catalog:",
    "tinyexec": "catalog:",
    "tsdown": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "unrun": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:vitest"
  }
}
